# Caminho do banco SQLite (padrão: servers.db)
# SQLITE_PATH=servers.db

# Credenciais do servidor padrão semeado quando binlog_servers está vazia
SERVER_ID=
REPLICA_ID=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_FLAVOR=mariadb

# Endereço do Redis (fila de eventos via asynq; docker compose up -d redis)
REDIS_ADDR=localhost:5000

# Número de shards da fila HTTP (ordem de entrega preservada por recurso
# dentro de cada shard; recursos diferentes em shards diferentes rodam em
# paralelo). PRECISA ser o mesmo valor no processo produtor (go run .) e no
# consumer (go run . consumer http) — um valor divergente faz eventos
# roteados para um shard "extra" ficarem parados sem erro visível. Mudar em
# produção exige coordenar os dois processos (não é hot-reload seguro).
HTTP_CONSUMER_SHARDS=16

# Usado apenas pelo subcomando "consumer http": o consumer HTTP não entrega
# direto ao cliente final nem lê clientes_hooks/cliente — repassa o evento
# para o srp-hub-api (POST <SRP_HUB_API_BASE_URL>/interno/hooks/<tipo>), que
# já resolve os destinos e faz o fan-out. SRP_HUB_API_TOKEN é o valor cru
# enviado no header Authorization (SEM prefixo "Bearer") — vem de uma NOVA
# linha em cliente_hub_autenticacao no srp-hub-api, com tenant='srp' (exigido
# pelo middleware de auth de lá pra liberar /interno/hooks/*) mas um token
# PRÓPRIO, diferente do usado pelo sistema legado que chama essa rota hoje.
# Precisa ser pedida a quem administra aquele banco — não existe valor de
# desenvolvimento default. Veja o README para o histórico dessa decisão.
SRP_HUB_API_BASE_URL=
SRP_HUB_API_TOKEN=
