# Caminho do banco SQLite (padrão: servers.db)
# SQLITE_PATH=servers.db

# Credenciais do servidor padrão semeado quando binlog_servers está vazia
SERVER_ID=
REPLICA_ID=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_FLAVOR=mariadb

# Endereço do Redis (fila de eventos via asynq; docker compose up -d redis)
REDIS_ADDR=localhost:5000

# Número de shards da fila HTTP (ordem de entrega preservada por recurso
# dentro de cada shard; recursos diferentes em shards diferentes rodam em
# paralelo). PRECISA ser o mesmo valor no processo produtor (go run .) e no
# consumer (go run . consumer http) — um valor divergente faz eventos
# roteados para um shard "extra" ficarem parados sem erro visível. Mudar em
# produção exige coordenar os dois processos (não é hot-reload seguro).
HTTP_CONSUMER_SHARDS=16

# A conexão com o MariaDB do hub (schema hub_<ambiente>, destinos de webhook)
# NÃO é uma env var — fica em hub_config (servers.db), configurada via:
#   go run . hub set -host ... -port ... -user ... -password ... -schema ...
# Veja "go run . hub" no README.
